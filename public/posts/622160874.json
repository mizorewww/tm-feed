":"概念图","author":"Piotr Wozniak","votes":6,"minutes":2,"reason":"同专栏下一篇 · 认知基石 & 教育培训"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本文直接引用"},{"id":"611469462","title":"学校教育的问题","author":"Piotr Wozniak","votes":446,"minutes":10,"reason":"本文直接引用"},{"id":"303204832","title":"彼得 · 沃兹尼亚克","author":"Piotr Wozniak","votes":70,"minutes":9,"reason":"本文直接引用"}],"rec_bridge":[{"id":"2059936154183587504","title":"如何从对话中学习","author":"Neel Nanda","votes":64,"minutes":4,"reason":"跨作者共鸣「好奇心」· Neel Nanda"},{"id":"2068268922776839997","title":"好奇心与兴趣","author":"Piotr Wozniak","votes":46,"minutes":4,"reason":"跨作者共鸣「好奇心」· Piotr Wozniak"},{"id":"1972234251777840886","title":"创造力、乐趣与内在动机的形式化理论","author":"Jürgen Schmidhuber","votes":30,"minutes":22,"reason":"跨作者共鸣「好奇心」· Jürgen Schmidhuber"},{"id":"689271349","title":"喜欢和渴望所涉及的神经回路","author":"Susana Peciña","votes":21,"minutes":1,"reason":"跨学派视角 · Susana Peciña"},{"id":"562035095","title":"感受学习乐趣的过程涉及到阿片受体","author":"Irving Biederman","votes":8,"minutes":1,"reason":"跨学派视角 · Irving Biederman"}],"rec_answers":[]}