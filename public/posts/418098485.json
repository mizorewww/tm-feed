/li><li id=\"ref-23\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-23\">↩</a> 学校奴役即将结束 <a class=\"tm-internal\" data-tm-id=\"602033506\" href=\"#/post/602033506\">站内阅读 ↗</a></li><li id=\"ref-24\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-24\">↩</a> 结束学校奴役 <a class=\"tm-internal\" data-tm-id=\"592277212\" href=\"#/post/592277212\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"417595864","title":"考试","author":"Piotr Wozniak","votes":45,"minutes":8,"reason":"同专栏上一篇 · 学校教育问题"},{"id":"427095337","title":"你会忍心把小狗关进笼子吗？","author":"Piotr Wozniak","votes":25,"minutes":6,"reason":"同专栏下一篇 · 学校教育问题"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本文直接引用"},{"id":"515605862","title":"John Holt","author":"Piotr Wozniak","votes":14,"minutes":2,"reason":"本文直接引用"},{"id":"264327134","title":"一致性与连贯性","author":"Piotr Wozniak","votes":60,"minutes":2,"reason":"本文直接引用"}],"rec_bridge":[{"id":"488362923","title":"学校压力使学生更容易成瘾","author":"Rajita Sinha","votes":508,"minutes":3,"reason":"被 9 篇回答共同引用 · Rajita Sinha"},{"id":"596048885","title":"学校毁掉了我的世界","author":"Alex Giorev","votes":231,"minutes":3,"reason":"跨作者共鸣「强制学校教育」· Alex Giorev"}],"rec_answers":[{"id":"2525321386","title":"为什么越来越多的大学生沉溺于游戏？","author":"Thoughts Memo","votes":2416,"minutes":11,"reason":"核心节选引用 · 2416 赞同","evidence":"正文以明确的标题/术语锚点“强制学校教育必须结束”原生链接到目标译文，目标摘要与所在论述相符。"},{"id":"2334764105","title":"我们的教育是究竟为了培养(育)人还是淘汰人？","author":"Thoughts Memo","votes":1745,"minutes":14,"reason":"核心节选引用 · 1745 赞同","evidence":"回答含指向该译文的原生引用锚点，可唯一定位到该标题/关键词。"},{"id":"3095512261","title":"研究发现早晨课越多成绩越差，涉及到哪些医学知识？","author":"Thoughts Memo","votes":1486,"minutes":14,"reason":"核心节选引用 · 1486 赞同","evidence":"回答正文中的原生链接锚点“强制学校教育必须结束”明确指向该译文；该证据支持标题/关键词提及。"},{"id":"2714892585","title":"高中生不愿臣服应试教育怎么办？","author":"Thoughts Memo","votes":1450,"minutes":8,"reason":"核心节选引用 · 1450 赞同","evidence":"回答正文保留指向目标译文的原生交叉引用“强制学校教育必须结束”；逐对核对后未见该页独有内容的改写或摘抄，确认为标题/链接层级。"},{"id":"2798075773","title":"请问中国式教育有多悲哀?","author":"Thoughts Memo","votes":703,"minutes":34,"reason":"核心节选引用 · 703 赞同","evidence":"回答正文以原生链接锚点“强制学校教育必须结束”明确指向该译文；这只支持标题/关键词提及。"}]}