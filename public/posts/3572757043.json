v2-cf39d29cd04d79200987cb52f7007dd6_720w.jpg?source=2c26e567\" data-original-token=\"v2-48b94a799a9c2b13613cf8f21b87500d\" decoding=\"async\" loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://pica.zhimg.com/v2-48b94a799a9c2b13613cf8f21b87500d_r.jpg?source=2c26e567\" width=\"720\"/></noscript><img class=\"origin_image zh-lightbox-thumb lazy\" data-default-watermark-src=\"https://pic1.zhimg.com/50/v2-cf39d29cd04d79200987cb52f7007dd6_720w.jpg?source=2c26e567\" data-original-token=\"v2-48b94a799a9c2b13613cf8f21b87500d\" decoding=\"async\" loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://pic1.zhimg.com/50/v2-48b94a799a9c2b13613cf8f21b87500d_720w.jpg?source=2c26e567\" width=\"720\"/></figure><h2 id=\"sec-2\">进一步阅读</h2><a class=\"internal tm-internal\" data-image=\"https://pic2.zhimg.com/v2-f6e161ad3808cb3a2fd7a6cdaf86af0f_180x120.jpg\" data-image-height=\"947\" data-image-width=\"1280\" data-tm-id=\"520591051\" href=\"#/post/520591051\">Thoughts Memo：普鲁士的纪律不可避免地摧毁了教育</a><a class=\"internal tm-internal\" data-image=\"https://pic1.zhimg.com/v2-ee33b2bb18327ac4b1e6be98258614fa_180x120.jpg\" data-image-height=\"2560\" data-image-width=\"3840\" data-tm-id=\"704266916\" href=\"#/post/704266916\">Thoughts Memo：学校的目标即是服从</a><a class=\"internal tm-internal\" data-image=\"https://pic4.zhimg.com/v2-4c13a43f49ca98c3b20ac3d49de90b1f_180x120.jpg\" data-image-height=\"2736\" data-image-width=\"3648\" data-tm-id=\"685942526\" href=\"#/post/685942526\">Thoughts Memo：学校驯育的人不理解自由学习</a><p></p><hr/><ol class=\"references\"><li id=\"ref-1\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-1\">↩</a> 过度强调成绩的代价 <a class=\"tm-internal\" data-tm-id=\"706663227\" href=\"#/post/706663227\">站内阅读 ↗</a></li><li id=\"ref-2\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-2\">↩</a> 标准化考试的「标准」同样值得警惕 <a class=\"tm-internal\" data-tm-id=\"651720303\" href=\"#/post/651720303\">站内阅读 ↗</a></li><li id=\"ref-3\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-3\">↩</a> 标准化考试及其受害者 <a class=\"tm-internal\" data-tm-id=\"642978888\" href=\"#/post/642978888\">站内阅读 ↗</a></li><li id=\"ref-4\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-4\">↩</a> 混淆「更难」与「更好」 <a class=\"tm-internal\" data-tm-id=\"706249314\" href=\"#/post/706249314\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"520591051","title":"普鲁士的纪律不可避免地摧毁了教育","author":"Piotr Wozniak","votes":1281,"minutes":6,"reason":"本回答Level 1 核心引用"},{"id":"704266916","title":"学校的目标即是服从","author":"Robin Hanson","votes":233,"minutes":6,"reason":"本回答Level 1 核心引用"},{"id":"685942526","title":"学校驯育的人不理解自由学习","author":"Piotr Wozniak","votes":163,"minutes":10,"reason":"本回答Level 1 核心引用"},{"id":"706663227","title":"过度强调成绩的代价","author":"Alfie Kohn","votes":86,"minutes":13,"reason":"本回答Level 1 核心引用"},{"id":"706249314","title":"混淆「更难」与「更好」","author":"Alfie Kohn","votes":78,"minutes":7,"reason":"本回答Level 1 核心引用"},{"id":"642978888","title":"美国标准化考试及其受害者","author":"Alfie Kohn","votes":64,"minutes":10,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"651720303","title":"标准化考试的「标准」同样值得警惕","author":"Alfie Kohn","votes":52,"minutes":11,"reason":"延伸深读 · Alfie Kohn"},{"id":"633496734","title":"反分数论","author":"Alfie Kohn","votes":142,"minutes":25,"reason":"延伸深读 · Alfie Kohn"},{"id":"706970909","title":"反对「更严格标准」的理由","author":"Alfie Kohn","votes":31,"minutes":7,"reason":"延伸深读 · Alfie Kohn"},{"id":"644162754","title":"标准化考试：孩子们被区分为麦穗和糠秕","author":"Alfie Kohn","votes":91,"minutes":6,"reason":"延伸深读 · Alfie Kohn"},{"id":"707318764","title":"教育工作者的十二条核心指南","author":"Alfie Kohn","votes":33,"minutes":2,"reason":"延伸深读 · Alfie Kohn"}],"rec_answers":[{"id":"3559518642","title":"如何看待只注重成绩唯分数论的教育方式？","author":"Thoughts Memo","votes":58,"minutes":14,"reason":"相似问答 · 58 赞同"},{"id":"3182336631","title":"为什么义务教育期间，宁愿教学生例如“根号”等可能一辈子都用不到的知识，也不教《劳动法》等实用知识？","author":"Thoughts Memo","votes":140,"minutes":2,"reason":"相似问答 · 140 赞同"},{"id":"3270965674","title":"在我国“应试教育”背景下，学生对教材的批判性思维是否有必要？","author":"Thoughts Memo","votes":91,"minutes":1,"reason":"相似问答 · 91 赞同"},{"id":"3571458919","title":"在中国推广素质教育是不是西方资本和境外势力的一个大阴谋？","author":"Thoughts Memo","votes":55,"minutes":3,"reason":"相似问答 · 55 赞同"},{"id":"3563861770","title":"应该做一个怎样的教育工作者？","author":"Thoughts Memo","votes":25,"minutes":2,"reason":"相似问答 · 25 赞同"}]}