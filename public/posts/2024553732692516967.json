</a> 鲁莽 <a class=\"tm-internal\" data-tm-id=\"2009342379862280068\" href=\"#/post/2009342379862280068\">站内阅读 ↗</a></li><li id=\"ref-23\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-23\">↩</a> 反抗 <a class=\"tm-internal\" data-tm-id=\"2013698640993068681\" href=\"#/post/2013698640993068681\">站内阅读 ↗</a></li><li id=\"ref-24\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-24\">↩</a> 我们将如何被衡量 <a class=\"tm-internal\" data-tm-id=\"2015014462667628594\" href=\"#/post/2015014462667628594\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"2015014462667628594","title":"我们将如何被衡量","author":"Nate Soares","votes":57,"minutes":4,"reason":"同专栏上一篇 · 超越内疚"},{"id":"2024556279192909342","title":"《超越内疚》 目录","author":"Nate Soares","votes":60,"minutes":1,"reason":"同专栏下一篇 · 超越内疚"},{"id":"1916181681422960007","title":"「应该」一词的危害","author":"Nate Soares","votes":232,"minutes":7,"reason":"本文直接引用"},{"id":"1941792108211054104","title":"世上没有「坏人」","author":"Nate Soares","votes":96,"minutes":7,"reason":"本文直接引用"},{"id":"1926221776146396166","title":"休息，应在行动之中","author":"Nate Soares","votes":1207,"minutes":13,"reason":"本文直接引用"}],"rec_bridge":[{"id":"2037246808632586458","title":"你的标准太高了","author":"Neel Nanda","votes":178,"minutes":20,"reason":"跨作者共鸣「内疚」· Neel Nanda"},{"id":"1941989096428898139","title":"内在动机：深度解析","author":"Frazer Mawson","votes":239,"minutes":44,"reason":"跨作者共鸣「内在动机」· Frazer Mawson"},{"id":"698044137","title":"赞美民科主义","author":"Peter Gray","votes":75,"minutes":6,"reason":"跨作者共鸣「内在动机」· Peter Gray"},{"id":"447958900","title":"内驱调节的学习是自我实现的；外驱调节的学习是自我否定的","author":"Andy Matuschak","votes":44,"minutes":2,"reason":"跨作者共鸣「内在动机」· Andy Matuschak"},{"id":"24426750334","title":"「再努力点」在某些情况下可能是个糟糕的策略","author":"Sasha Chapin","votes":65,"minutes":2,"reason":"跨作者共鸣「行动选择」· Sasha Chapin"}],"rec_answers":[]}