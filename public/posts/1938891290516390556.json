tle":"元素交互性","author":"Andy Matuschak","votes":5,"minutes":3,"reason":"同专栏下一篇 · 认知基石 & 教育培训"},{"id":"695969718","title":"《启蒙琼林》是 Nell 余生的一次大型「入职」经历","author":"Andy Matuschak","votes":5,"minutes":2,"reason":"本文直接引用"},{"id":"694984639","title":"《少龄淑女绘本启蒙琼林》","author":"Andy Matuschak","votes":9,"minutes":2,"reason":"本文直接引用"},{"id":"1924886118987465823","title":"建构主义","author":"Andy Matuschak","votes":25,"minutes":4,"reason":"本文直接引用"}],"rec_bridge":[],"rec_answers":[]}