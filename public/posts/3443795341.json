↩</a> 大多数游戏都不是赋能环境 <a class=\"tm-internal\" data-tm-id=\"588396638\" href=\"#/post/588396638\">站内阅读 ↗</a></li><li id=\"ref-18\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-18\">↩</a> 赋能环境中的活动直接服务于有内在意义的目的 <a class=\"tm-internal\" data-tm-id=\"482949294\" href=\"#/post/482949294\">站内阅读 ↗</a></li><li id=\"ref-19\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-19\">↩</a> 教育计划往往会自我颠覆 <a class=\"tm-internal\" data-tm-id=\"448382399\" href=\"#/post/448382399\">站内阅读 ↗</a></li><li id=\"ref-20\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-20\">↩</a> 创制环境极大程度受作者的动机塑造 <a class=\"tm-internal\" data-tm-id=\"463811042\" href=\"#/post/463811042\">站内阅读 ↗</a></li><li id=\"ref-21\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-21\">↩</a> 强大的赋能环境通常是追求自身内在意义的项目的副产品 <a class=\"tm-internal\" data-tm-id=\"558196133\" href=\"#/post/558196133\">站内阅读 ↗</a></li><li id=\"ref-22\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-22\">↩</a> 强大的赋能环境注重专业用例 <a class=\"tm-internal\" data-tm-id=\"638575951\" href=\"#/post/638575951\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"458337989","title":"赋能环境","author":"Andy Matuschak","votes":32,"minutes":3,"reason":"本回答Level 1 核心引用"},{"id":"457666825","title":"认知脚手架","author":"Andy Matuschak","votes":32,"minutes":2,"reason":"本回答Level 1 核心引用"},{"id":"448382399","title":"教育计划往往会自我颠覆","author":"Andy Matuschak","votes":31,"minutes":3,"reason":"本回答Level 1 核心引用"},{"id":"542384570","title":"笔记类型体系","author":"Andy Matuschak","votes":28,"minutes":3,"reason":"本回答Level 1 核心引用"},{"id":"463926133","title":"情景体验（Enacted experience）","author":"Andy Matuschak","votes":20,"minutes":3,"reason":"本回答Level 1 核心引用"},{"id":"560849079","title":"游戏帮助玩家评估他们养成的技能","author":"Andy Matuschak","votes":13,"minutes":1,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"588396638","title":"大多数游戏都不是赋能环境","author":"Andy Matuschak","votes":12,"minutes":1,"reason":"延伸深读 · Andy Matuschak"},{"id":"555033920","title":"游戏能有效地培养玩家的技能","author":"Andy Matuschak","votes":13,"minutes":2,"reason":"延伸深读 · Andy Matuschak"},{"id":"529510540","title":"教育游戏","author":"Andy Matuschak","votes":10,"minutes":1,"reason":"延伸深读 · Andy Matuschak"},{"id":"602800824","title":"游戏中的技能培养服从于其他有内在意义的目的","author":"Andy Matuschak","votes":10,"minutes":2,"reason":"延伸深读 · Andy Matuschak"},{"id":"460904593","title":"教育游戏对于创造赋能环境是注定失败的方法","author":"Andy Matuschak","votes":18,"minutes":2,"reason":"延伸深读 · Andy Matuschak"}],"rec_answers":[{"id":"3116624476","title":"为什么游戏化学习没有成为主流？","author":"Thoughts Memo","votes":176,"minutes":3,"reason":"相似问答 · 176 赞同"},{"id":"3225403127","title":"为什么游戏设计师可以设计出让人上瘾的游戏，而教育设计师设计让人上瘾的学习比较少?","author":"Thoughts Memo","votes":173,"minutes":11,"reason":"相似问答 · 173 赞同"},{"id":"1943678101944013683","title":"如果把知识做成游戏，以玩游戏的方式进行学习，学习效率会不会增加？","author":"Thoughts Memo","votes":136,"minutes":6,"reason":"相似问答 · 136 赞同"},{"id":"2531966162","title":"为什么没有教育相关的游戏或者其火不起来？","author":"Thoughts Memo","votes":22,"minutes":2,"reason":"相似问答 · 22 赞同"},{"id":"3518604542","title":"游戏猖獗，怎么不把游戏和学习相结合？用知识提升来当游戏升级挑战呢？","author":"Thoughts Memo","votes":51,"minutes":11,"reason":"相似问答 · 51 赞同"}]}