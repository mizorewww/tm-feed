tes":299,"minutes":4,"reason":"本回答Level 1 核心引用"},{"id":"67390960","title":"9 毒性记忆","author":"Piotr Wozniak","votes":227,"minutes":24,"reason":"本回答Level 1 核心引用"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本回答Level 1 核心引用"},{"id":"65899656","title":"7 学习内驱力与习得性无助","author":"Piotr Wozniak","votes":167,"minutes":11,"reason":"本回答Level 1 核心引用"},{"id":"273225977","title":"学习的基本规律","author":"Piotr Wozniak","votes":137,"minutes":4,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"351872034","title":"学习中的强迫","author":"Piotr Wozniak","votes":57,"minutes":3,"reason":"延伸深读 · Piotr Wozniak"},{"id":"575245791","title":"习得性无助","author":"Piotr Wozniak","votes":235,"minutes":3,"reason":"延伸深读 · Piotr Wozniak"},{"id":"559705516","title":"学校让人沾染上的 100+ 恶习","author":"Piotr Wozniak","votes":8728,"minutes":132,"reason":"延伸深读 · Piotr Wozniak"},{"id":"630451665","title":"大脑是完美的适应装置","author":"Piotr Wozniak","votes":145,"minutes":22,"reason":"延伸深读 · Piotr Wozniak"},{"id":"539022457","title":"学校外驱力","author":"Piotr Wozniak","votes":11,"minutes":3,"reason":"延伸深读 · Piotr Wozniak"}],"rec_answers":[{"id":"2518112993","title":"「学这些干什么买菜又用不到」，是中国特有的反智主义，还是强压教育下必然出现的结果？","author":"Thoughts Memo","votes":872,"minutes":9,"reason":"相似问答 · 872 赞同"},{"id":"2878762196","title":"为什么我们的孩子学习的时候都不快乐？","author":"Thoughts Memo","votes":136,"minutes":9,"reason":"相似问答 · 136 赞同"},{"id":"2953326692","title":"ChatGPT会对应试教育带来革命吗？","author":"Thoughts Memo","votes":278,"minutes":9,"reason":"相似问答 · 278 赞同"},{"id":"2762984641","title":"为什么很多人高考结束后进入大学就堕落了？","author":"Thoughts Memo","votes":410,"minutes":18,"reason":"相似问答 · 410 赞同"},{"id":"2714892585","title":"高中生不愿臣服应试教育怎么办？","author":"Thoughts Memo","votes":1450,"minutes":8,"reason":"相似问答 · 1450 赞同"}]}