s=\"tm-internal\" data-tm-id=\"242815901\" href=\"#/post/242815901\">站内阅读 ↗</a></li><li id=\"ref-14\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-14\">↩</a> 被动的学校教育 <a class=\"tm-internal\" data-tm-id=\"359037513\" href=\"#/post/359037513\">站内阅读 ↗</a></li><li id=\"ref-15\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-15\">↩</a> 封闭系统中的社会化 <a class=\"tm-internal\" data-tm-id=\"584230135\" href=\"#/post/584230135\">站内阅读 ↗</a></li><li id=\"ref-16\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-16\">↩</a> 习得性无助 <a class=\"tm-internal\" data-tm-id=\"575245791\" href=\"#/post/575245791\">站内阅读 ↗</a></li><li id=\"ref-17\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-17\">↩</a> 我们需要更多烂学校 <a class=\"tm-internal\" data-tm-id=\"611001382\" href=\"#/post/611001382\">站内阅读 ↗</a></li><li id=\"ref-18\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-18\">↩</a> 让陈旧的学校系统继续存活的谬误 <a class=\"tm-internal\" data-tm-id=\"386372396\" href=\"#/post/386372396\">站内阅读 ↗</a></li><li id=\"ref-19\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-19\">↩</a> 0 目录《我永远不会送我的孩子去学校》 <a href=\"https://zhuanlan.zhihu.com/p/73383015\" rel=\"noopener noreferrer\" target=\"_blank\">https://zhuanlan.zhihu.com/p/73383015</a></li><li id=\"ref-20\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-20\">↩</a> 学校教育的问题 <a class=\"tm-internal\" data-tm-id=\"611469462\" href=\"#/post/611469462\">站内阅读 ↗</a></li><li id=\"ref-21\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-21\">↩</a> 彼得 · 沃兹尼亚克 <a class=\"tm-internal\" data-tm-id=\"303204832\" href=\"#/post/303204832\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"597949223","title":"奖励剥夺","author":"Piotr Wozniak","votes":82,"minutes":2,"reason":"同专栏上一篇 · 学校教育问题"},{"id":"598988410","title":"学校要么改革，要么灭亡","author":"Piotr Wozniak","votes":171,"minutes":3,"reason":"同专栏下一篇 · 学校教育问题"},{"id":"73348892","title":"19 童年的热爱","author":"Piotr Wozniak","votes":45,"minutes":12,"reason":"本文直接引用"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本文直接引用"},{"id":"575245791","title":"习得性无助","author":"Piotr Wozniak","votes":235,"minutes":3,"reason":"本文直接引用"}],"rec_bridge":[],"rec_answers":[{"id":"2091896782758340000","title":"法国千所学校抗议演变成暴力骚乱，背后深层原因是什么？","author":"Thoughts Memo","votes":1780,"minutes":3,"reason":"核心节选引用 · 1780 赞同","evidence":"回答正文含明确指向该译文的知乎内链/链接卡，按直接提及记为1级。"},{"id":"2086025669557987029","title":"官方通报「南京一幼儿园发生集体呕吐，监控发现食堂用炒菜锅洗拖把」，11名责任人被处理，如何看待此事？","author":"Thoughts Memo","votes":506,"minutes":3,"reason":"核心节选引用 · 506 赞同","evidence":"逐对核对后，回答锚点“谬误：你可以砸更多的钱来改进教育系统”与目标译文标题或唯一关键词相符。"}]}