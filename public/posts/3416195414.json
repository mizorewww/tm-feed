":"602150910","title":"学习的乐趣","author":"Piotr Wozniak","votes":1152,"minutes":88,"reason":"延伸深读 · Piotr Wozniak"},{"id":"269974053","title":"干扰","author":"Piotr Wozniak","votes":28,"minutes":1,"reason":"延伸深读 · Piotr Wozniak"},{"id":"273225977","title":"学习的基本规律","author":"Piotr Wozniak","votes":137,"minutes":4,"reason":"延伸深读 · Piotr Wozniak"},{"id":"599716977","title":"睡眠不足会放大学校的危害","author":"Piotr Wozniak","votes":171,"minutes":4,"reason":"延伸深读 · Piotr Wozniak"},{"id":"264327134","title":"一致性与连贯性","author":"Piotr Wozniak","votes":60,"minutes":2,"reason":"延伸深读 · Piotr Wozniak"}],"rec_answers":[{"id":"3095512261","title":"研究发现早晨课越多成绩越差，涉及到哪些医学知识？","author":"Thoughts Memo","votes":1486,"minutes":14,"reason":"相似问答 · 1486 赞同"},{"id":"2714892585","title":"高中生不愿臣服应试教育怎么办？","author":"Thoughts Memo","votes":1450,"minutes":8,"reason":"相似问答 · 1450 赞同"},{"id":"2024783376297596199","title":"如何看待“学生和家长仅仅希望高中不要凌晨五点半就到校，多睡一个小时，就被指责为想搞快乐教育”这句话？","author":"Thoughts Memo","votes":804,"minutes":82,"reason":"相似问答 · 804 赞同"},{"id":"3260921778","title":"每个人的智商是天生就已经确定了的吗？后天努力可以提高智商吗？","author":"Thoughts Memo","votes":170,"minutes":7,"reason":"相似问答 · 170 赞同"},{"id":"117708177094","title":"早读和晚自习真的有意义吗？你支持取消早读和晚自习吗？","author":"Thoughts Memo","votes":353,"minutes":16,"reason":"相似问答 · 353 赞同"}]}