2\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"694419305","title":"讲座能让我们窥见专家的思考方式","author":"Andy Matuschak","votes":52,"minutes":4,"reason":"同专栏上一篇 · 助记媒介 & 思想工具"},{"id":"694825399","title":"参与式环境支持学习","author":"Andy Matuschak","votes":7,"minutes":1,"reason":"同专栏下一篇 · 助记媒介 & 思想工具"},{"id":"694282984","title":"Y Combinator","author":"Andy Matuschak","votes":15,"minutes":2,"reason":"本文直接引用"},{"id":"698476935","title":"§赋能环境、游戏和《启蒙琼林》","author":"Andy Matuschak","votes":9,"minutes":6,"reason":"本文直接引用"},{"id":"628118503","title":"对赋能环境不熟悉的人往往不能完成环境所赋能的事情","author":"Andy Matuschak","votes":7,"minutes":1,"reason":"本文直接引用"}],"rec_bridge":[{"id":"15916671283","title":"论意志的慈善","author":"Michael Nielsen","votes":48,"minutes":3,"reason":"跨作者共鸣「赋能环境」· Michael Nielsen"}],"rec_answers":[]}