\">↩</a> 强大的赋能环境注重专业用例 <a class=\"tm-internal\" data-tm-id=\"638575951\" href=\"#/post/638575951\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"460589618","title":"学校改革：进化还是革命？","author":"Piotr Wozniak","votes":62,"minutes":10,"reason":"同专栏上一篇 · 学校教育问题"},{"id":"468808447","title":"教育的录音机模型","author":"Piotr Wozniak","votes":10,"minutes":1,"reason":"同专栏下一篇 · 学校教育问题"},{"id":"698476935","title":"§赋能环境、游戏和《启蒙琼林》","author":"Andy Matuschak","votes":9,"minutes":6,"reason":"本文直接引用"},{"id":"695746771","title":"《启蒙琼林》并不是一个可行的赋能环境","author":"Andy Matuschak","votes":9,"minutes":3,"reason":"本文直接引用"},{"id":"1964140322876552061","title":"《启蒙琼林》的活动之所以对 Nell 具有内在意义，全因其生活的贫乏","author":"Andy Matuschak","votes":3,"minutes":2,"reason":"本文直接引用"}],"rec_bridge":[{"id":"15916671283","title":"论意志的慈善","author":"Michael Nielsen","votes":48,"minutes":3,"reason":"跨作者共鸣「赋能环境」· Michael Nielsen"}],"rec_answers":[{"id":"3116624476","title":"为什么游戏化学习没有成为主流？","author":"Thoughts Memo","votes":176,"minutes":3,"reason":"延伸提及 · 176 赞同","evidence":"正文连续重现了该译文的具体论述/图示内容，目标有对应链接锚点或准确标题，符合三级。"},{"id":"3225403127","title":"为什么游戏设计师可以设计出让人上瘾的游戏，而教育设计师设计让人上瘾的学习比较少?","author":"Thoughts Memo","votes":173,"minutes":11,"reason":"延伸提及 · 173 赞同","evidence":"回答正文连续重现目标译文的特异内容，且译文侧对应段落可逐字核验。"},{"id":"1943678101944013683","title":"如果把知识做成游戏，以玩游戏的方式进行学习，学习效率会不会增加？","author":"Thoughts Memo","votes":136,"minutes":6,"reason":"延伸提及 · 136 赞同","evidence":"回答在明示摘引该译文后连续重现其关于游戏与动机的具体论述（150个归一化字符匹配）。"},{"id":"3518604542","title":"游戏猖獗，怎么不把游戏和学习相结合？用知识提升来当游戏升级挑战呢？","author":"Thoughts Memo","votes":51,"minutes":11,"reason":"延伸提及 · 51 赞同","evidence":"答文明确标注并直接重现该译文的独特正文段落。"},{"id":"3443795341","title":"游戏与教育一定是对立的吗？","author":"Thoughts Memo","votes":49,"minutes":7,"reason":"延伸提及 · 49 赞同","evidence":"回答正文与该译文存在连续原文复现，属于正文摘录。"}]}