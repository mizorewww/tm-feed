=\"576166369\" href=\"#/post/576166369\">站内阅读 ↗</a></li><li id=\"ref-29\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-29\">↩</a> 被动的学校教育 <a class=\"tm-internal\" data-tm-id=\"359037513\" href=\"#/post/359037513\">站内阅读 ↗</a></li><li id=\"ref-30\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-30\">↩</a> 间隔重复 (spaced repetition) <a class=\"tm-internal\" data-tm-id=\"305651556\" href=\"#/post/305651556\">站内阅读 ↗</a></li><li id=\"ref-31\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-31\">↩</a> 0 目录《我永远不会送我的孩子去学校》 <a href=\"https://zhuanlan.zhihu.com/p/73383015\" rel=\"noopener noreferrer\" target=\"_blank\">https://zhuanlan.zhihu.com/p/73383015</a></li><li id=\"ref-32\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-32\">↩</a> 学校教育的问题 <a class=\"tm-internal\" data-tm-id=\"611469462\" href=\"#/post/611469462\">站内阅读 ↗</a></li><li id=\"ref-33\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-33\">↩</a> 彼得 · 沃兹尼亚克 <a class=\"tm-internal\" data-tm-id=\"303204832\" href=\"#/post/303204832\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"595724491","title":"学习中的反馈","author":"Piotr Wozniak","votes":53,"minutes":6,"reason":"同专栏上一篇 · 学校教育问题"},{"id":"596048885","title":"学校毁掉了我的世界","author":"Alex Giorev","votes":231,"minutes":3,"reason":"同专栏下一篇 · 学校教育问题"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本文直接引用"},{"id":"64572381","title":"6 学习内驱力和奖励（6.11-6.16）","author":"Piotr Wozniak","votes":62,"minutes":20,"reason":"本文直接引用"},{"id":"66279009","title":"8 教育与进化背道而驰","author":"Piotr Wozniak","votes":90,"minutes":14,"reason":"本文直接引用"}],"rec_bridge":[],"rec_answers":[{"id":"2024783376297596199","title":"如何看待“学生和家长仅仅希望高中不要凌晨五点半就到校，多睡一个小时，就被指责为想搞快乐教育”这句话？","author":"Thoughts Memo","votes":804,"minutes":82,"reason":"核心节选引用 · 804 赞同","evidence":"逐对核验：回答用该译文的直接脚注锚点指向文章标题或对应的特定术语。"},{"id":"3333217724","title":"学习是一件反人类的事情吗？","author":"Thoughts Memo","votes":546,"minutes":90,"reason":"核心节选引用 · 546 赞同","evidence