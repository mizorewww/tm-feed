author":"Piotr Wozniak","votes":499,"minutes":32,"reason":"本回答Level 1 核心引用"},{"id":"67390960","title":"9 毒性记忆","author":"Piotr Wozniak","votes":227,"minutes":24,"reason":"本回答Level 1 核心引用"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本回答Level 1 核心引用"},{"id":"273225977","title":"学习的基本规律","author":"Piotr Wozniak","votes":137,"minutes":4,"reason":"本回答Level 1 核心引用"},{"id":"550075365","title":"自主教育的生物学基础","author":"Peter Gray","votes":94,"minutes":7,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"357893386","title":"我怎样才能外在地激励孩子?","author":"Piotr Wozniak","votes":28,"minutes":2,"reason":"延伸深读 · Piotr Wozniak"},{"id":"583003405","title":"学习的外在动机","author":"Piotr Wozniak","votes":55,"minutes":2,"reason":"延伸深读 · Piotr Wozniak"},{"id":"620721614","title":"表扬如何毁掉学习","author":"Piotr Wozniak","votes":197,"minutes":22,"reason":"延伸深读 · Piotr Wozniak"},{"id":"447958900","title":"内驱调节的学习是自我实现的；外驱调节的学习是自我否定的","author":"Andy Matuschak","votes":44,"minutes":2,"reason":"延伸深读 · Andy Matuschak"},{"id":"351872034","title":"学习中的强迫","author":"Piotr Wozniak","votes":57,"minutes":3,"reason":"延伸深读 · Piotr Wozniak"}],"rec_answers":[{"id":"19319161575","title":"教师如何激发学生主动学习的内驱力？","author":"Thoughts Memo","votes":93,"minutes":6,"reason":"相似问答 · 93 赞同"},{"id":"2596351300","title":"如何帮助孩子爱上学习？","author":"Thoughts Memo","votes":53,"minutes":2,"reason":"相似问答 · 53 赞同"},{"id":"2953326692","title":"ChatGPT会对应试教育带来革命吗？","author":"Thoughts Memo","votes":278,"minutes":9,"reason":"相似问答 · 278 赞同"},{"id":"2408841927","title":"放眼未来教育趋势，怎么看待“鸡娃”教育？","author":"Thoughts Memo","votes":18,"minutes":3,"reason":"相似问答 · 18 赞同"},{"id":"2010343460113253419","title":"如何看待这种观点：废掉一个孩子最快的方式，就是暑假带他到处旅游？","author":"Thoughts Memo","votes":1194,"minutes":8,"reason":"相似问答 · 1194 赞同"}]}