"author":"Henrik Karlsson","votes":110,"minutes":17,"reason":"延伸深读 · Henrik Karlsson"},{"id":"602150910","title":"学习的乐趣","author":"Piotr Wozniak","votes":1152,"minutes":88,"reason":"延伸深读 · Piotr Wozniak"},{"id":"559705516","title":"学校让人沾染上的 100+ 恶习","author":"Piotr Wozniak","votes":8728,"minutes":132,"reason":"延伸深读 · Piotr Wozniak"},{"id":"696904074","title":"情境学习 - Lave and Wenger","author":"Andy Matuschak","votes":27,"minutes":7,"reason":"延伸深读 · Andy Matuschak"},{"id":"365716946","title":"现代学校教育就像苏联经济","author":"Piotr Wozniak","votes":78,"minutes":11,"reason":"延伸深读 · Piotr Wozniak"}],"rec_answers":[{"id":"2011726612090098837","title":"美国为什么不给穷人搞低成本的应试教育？搞快乐教育不是在自掘坟墓吗?","author":"Thoughts Memo","votes":2101,"minutes":60,"reason":"相似问答 · 2101 赞同"},{"id":"2094495642341074348","title":"中办、国办发布《关于分类推进高校改革的意见》，对不同高校未来发展有什么影响？","author":"Thoughts Memo","votes":933,"minutes":7,"reason":"相似问答 · 933 赞同"},{"id":"2022063933494757269","title":"如果知识不再稀缺，那么大学教育的意义是什么？","author":"Thoughts Memo","votes":304,"minutes":26,"reason":"相似问答 · 304 赞同"},{"id":"2047392061687588063","title":"很多人说高三是自己的智力巅峰、知识储备量巅峰时期，是这样吗？这种说法有科学依据吗？","author":"Thoughts Memo","votes":1382,"minutes":5,"reason":"相似问答 · 1382 赞同"},{"id":"2008666247177463284","title":"如何看待马斯克认为现代年轻人没必要上大学了？","author":"Thoughts Memo","votes":369,"minutes":4,"reason":"相似问答 · 369 赞同"}]}