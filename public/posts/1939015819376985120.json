"66683201\" href=\"#/post/66683201\">站内阅读 ↗</a></li><li id=\"ref-27\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-27\">↩</a> 民主学校/在家上学/非学校教育 <a class=\"tm-internal\" data-tm-id=\"369568521\" href=\"#/post/369568521\">站内阅读 ↗</a></li><li id=\"ref-28\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-28\">↩</a> 渐进阅读 <a href=\"https://www.yuque.com/supermemo/wiki/incremental_reading\" rel=\"noopener noreferrer\" target=\"_blank\">https://www.yuque.com/supermemo/wiki/incremental_reading</a></li><li id=\"ref-29\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-29\">↩</a> 学习内驱力的最优性 <a class=\"tm-internal\" data-tm-id=\"357209357\" href=\"#/post/357209357\">站内阅读 ↗</a></li><li id=\"ref-30\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-30\">↩</a> 遗忘 <a class=\"tm-internal\" data-tm-id=\"558542113\" href=\"#/post/558542113\">站内阅读 ↗</a></li><li id=\"ref-31\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-31\">↩</a> 学校教育的问题 <a class=\"tm-internal\" data-tm-id=\"611469462\" href=\"#/post/611469462\">站内阅读 ↗</a></li><li id=\"ref-32\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-32\">↩</a> 彼得 · 沃兹尼亚克 <a class=\"tm-internal\" data-tm-id=\"303204832\" href=\"#/post/303204832\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"602150910","title":"学习的乐趣","author":"Piotr Wozniak","votes":1152,"minutes":88,"reason":"本回答Level 1 核心引用"},{"id":"592277212","title":"结束学校奴役","author":"Piotr Wozniak","votes":985,"minutes":8,"reason":"本回答Level 1 核心引用"},{"id":"611469462","title":"学校教育的问题","author":"Piotr Wozniak","votes":446,"minutes":10,"reason":"本回答Level 1 核心引用"},{"id":"272543239","title":"自由学习","author":"Piotr Wozniak","votes":299,"minutes":4,"reason":"本回答Level 1 核心引用"},{"id":"67390960","title":"9 毒性记忆","author":"Piotr Wozniak","votes":227,"minutes":24,"reason":"本回答Level 1 核心引用"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"685942526","title":"学校驯育的人不理解自由学习","author":"Piotr Wozniak","votes":163,"minutes":10,"reason":"延伸深读 · Piotr Wozniak"},{"id":"630451665","title":"大脑是完美的适应装置","author":"Piotr Wozniak","votes":145,"minutes":22,"reason":"延伸深读 · Piotr Wozniak"},{"id":"369391813","title":"成为优等生的危险","author":"Piotr Wozniak","votes":499,"minutes":32,"reason":"延伸深读 · Piotr Wozniak"},{"id":"351872034","title":"学习中的强迫","author":"Piotr Wozniak","votes":57,"minutes":3,"reason":"延伸深读 · Piotr Wozniak"},{"id":"357209357","title":"学习内驱力的最优性","author":"Piotr Wozniak","votes":60,"minutes":14,"reason":"延伸深读 · Piotr Wozniak"}],"rec_answers":[{"id":"89082348961","title":"十多年的应试教育扼杀了我的好奇心和求知欲，我该怎么办？","author":"Thoughts Memo","votes":2470,"minutes":20,"reason":"相似问答 · 2470 赞同"},{"id":"2017887574232937536","title":"中国的教育对孩子的伤害有多大。？","author":"Thoughts Memo","votes":332,"minutes":15,"reason":"相似问答 · 332 赞同"},{"id":"2975567430","title":"在学校里，教师应不应该阻止学生提出表面上看似是「胡思乱想」、「愚蠢」、和「无意义」的问题？","author":"Thoughts Memo","votes":130,"minutes":8,"reason":"相似问答 · 130 赞同"},{"id":"2334764105","title":"我们的教育是究竟为了培养(育)人还是淘汰人？","author":"Thoughts Memo","votes":1745,"minutes":14,"reason":"相似问答 · 1745 赞同"},{"id":"1968439846369489451","title":"「现在不吃上学的苦，以后就会吃生活的苦」，这种教育方式还适合当下吗？","author":"Thoughts Memo","votes":208,"minutes":36,"reason":"相似问答 · 208 赞同"}]}