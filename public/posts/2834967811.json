 ↗</a></li></ol>","rec_chain":[{"id":"416319260","title":"常青笔记（Evergreen notes）","author":"Andy Matuschak","votes":188,"minutes":3,"reason":"本回答Level 1 核心引用"},{"id":"481236886","title":"最好的阅读方式是高度语境化的","author":"Andy Matuschak","votes":55,"minutes":1,"reason":"本回答Level 1 核心引用"},{"id":"453852965","title":"我所认识的高效阅读者和思想家在阅读时不做笔记","author":"Andy Matuschak","votes":42,"minutes":2,"reason":"本回答Level 1 核心引用"},{"id":"438871051","title":"自主思考","author":"Andy Matuschak","votes":37,"minutes":4,"reason":"本回答Level 1 核心引用"},{"id":"436335609","title":"常青笔记和卡片盒笔记法的异同点","author":"Andy Matuschak","votes":37,"minutes":3,"reason":"本回答Level 1 核心引用"},{"id":"460888905","title":"如何在阅读时整理所得","author":"Andy Matuschak","votes":35,"minutes":2,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"446944151","title":"写你所读，以求内化","author":"Andy Matuschak","votes":49,"minutes":3,"reason":"延伸深读 · Andy Matuschak"},{"id":"533129885","title":"§ 笔记写作系统","author":"Andy Matuschak","votes":29,"minutes":3,"reason":"延伸深读 · Andy Matuschak"},{"id":"448897897","title":"常青笔记有助于积累洞见","author":"Andy Matuschak","votes":23,"minutes":3,"reason":"延伸深读 · Andy Matuschak"},{"id":"450623752","title":"常青笔记有助于积累阅读成果","author":"Andy Matuschak","votes":18,"minutes":1,"reason":"延伸深读 · Andy Matuschak"},{"id":"451268598","title":"如何将阅读标注处理成常青笔记","author":"Andy Matuschak","votes":25,"minutes":3,"reason":"延伸深读 · Andy Matuschak"}],"rec_answers":[{"id":"2772990761","title":"如何构建自己的笔记系统？","author":"Thoughts Memo","votes":755,"minutes":20,"reason":"相似问答 · 755 赞同"},{"id":"2446781501","title":"你是如何使用双链笔记软件做笔记的？","author":"Thoughts Memo","votes":46,"minutes":6,"reason":"相似问答 · 46 赞同"},{"id":"2832363029","title":"干货答案只收藏不看是什么样的心理？","author":"Thoughts Memo","votes":176,"minutes":3,"reason":"相似问答 · 176 赞同"},{"id":"2831205170","title":"记笔记真的有用吗？","author":"Thoughts Memo","votes":174,"minutes":5,"reason":"相似问答 · 174 赞同"},{"id":"3202245608","title":"用双链笔记软件做的笔记会很杂乱吗？","author":"Thoughts Memo","votes":143,"minutes":4,"reason":"相似问答 · 143 赞同"}]}