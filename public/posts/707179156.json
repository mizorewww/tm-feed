lass=\"ref-back\" href=\"#cite-16\">↩</a> 学习的乐趣 <a class=\"tm-internal\" data-tm-id=\"602150910\" href=\"#/post/602150910\">站内阅读 ↗</a></li><li id=\"ref-17\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-17\">↩</a> 强制学校教育必须结束 <a class=\"tm-internal\" data-tm-id=\"418098485\" href=\"#/post/418098485\">站内阅读 ↗</a></li><li id=\"ref-18\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-18\">↩</a> 家庭作业 <a class=\"tm-internal\" data-tm-id=\"501186817\" href=\"#/post/501186817\">站内阅读 ↗</a></li><li id=\"ref-19\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-19\">↩</a> 适用性 <a class=\"tm-internal\" data-tm-id=\"517317208\" href=\"#/post/517317208\">站内阅读 ↗</a></li><li id=\"ref-20\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-20\">↩</a> 稳定化 <a class=\"tm-internal\" data-tm-id=\"595158577\" href=\"#/post/595158577\">站内阅读 ↗</a></li><li id=\"ref-21\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-21\">↩</a> Alfie Kohn <a class=\"tm-internal\" data-tm-id=\"576166369\" href=\"#/post/576166369\">站内阅读 ↗</a></li><li id=\"ref-22\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-22\">↩</a> 创造力 <a class=\"tm-internal\" data-tm-id=\"450093869\" href=\"#/post/450093869\">站内阅读 ↗</a></li><li id=\"ref-23\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-23\">↩</a> 学校教育的问题 <a class=\"tm-internal\" data-tm-id=\"611469462\" href=\"#/post/611469462\">站内阅读 ↗</a></li><li id=\"ref-24\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-24\">↩</a> 彼得 · 沃兹尼亚克 <a class=\"tm-internal\" data-tm-id=\"303204832\" href=\"#/post/303204832\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"705713335","title":"反对学校教育的依据：引言","author":"Zvi Mowshowitz","votes":95,"minutes":10,"reason":"同专栏上一篇 · 学校教育问题"},{"id":"708841879","title":"学校教育的危害与希望","author":"TsviBT","votes":55,"minutes":15,"reason":"同专栏下一篇 · 学校教育问题"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本文直接引用"},{"id":"576166369","title":"Alfie Kohn","author":"Piotr Wozniak","votes":17,"minutes":1,"reason":"本文直接引用"},{"id":"264327134","title":"一致性与连贯性","author":"Piotr Wozniak","votes":60,"minutes":2,"reason":"本文直接引用"}],"rec_bridge":[{"id":"596048885","title":"学校毁掉了我的世界","author":"Alex Giorev","votes":231,"minutes":3,"reason":"跨作者共鸣「学习动机」· Alex Giorev"}],"rec_answers":[{"id":"2010343460113253419","title":"如何看待这种观点：废掉一个孩子最快的方式，就是暑假带他到处旅游？","author":"Thoughts Memo","votes":1194,"minutes":8,"reason":"核心节选引用 · 1194 赞同","evidence":"逐对核对后，回答锚点“暑假滑坡折射学校教育之殇”与目标译文标题或唯一关键词相符。"},{"id":"2017163223938376088","title":"如果某省或某市学校集体采购类anki工具，thoughts memo会转而歌颂学校制度吗？","author":"Thoughts Memo","votes":166,"minutes":28,"reason":"核心节选引用 · 166 赞同","evidence":"标题/关键词链接随主译文《间隔重复在课堂上是行不通的》的摘录带入；只确认标题提及，没有独立化用目标译文观点。锚点：「暑假滑坡折射学校教育之殇」。"},{"id":"96467859620","title":"孩子寒假作业年年「烂尾」，开学前一晚疯狂赶进度，如何看待这一现象？家长应该介入孩子的假期学习规划吗?","author":"Thoughts Memo","votes":192,"minutes":8,"reason":"延伸提及 · 192 赞同","evidence":"回答大段重现目标译文中关于暑假、无语义学习与记忆质量的连续内容。"},{"id":"3577689562","title":"每年暑假一来临，小孩子开始变懒散了，既不愿主动学习，甚至连作业也不愿再做了，怎么办，有什么好方法？","author":"Thoughts Memo","votes":51,"minutes":8,"reason":"延伸提及 · 51 赞同","evidence":"回答有明确直链，并连续摘录了该译文正文。"},{"id":"1930271508854440121","title":"教育部要求严控暑期作业总量，如何界定「过量作业」？此举能有效缓解学生压力吗？","author":"Thoughts Memo","votes":49,"minutes":15,"reason":"延伸提及 · 49 赞同","evidence":"回答正文连续重现目标译文的特异内容，且译文侧对应段落可逐字核验。"}]}