18\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-18\">↩</a> 家庭作业 <a class=\"tm-internal\" data-tm-id=\"501186817\" href=\"#/post/501186817\">站内阅读 ↗</a></li><li id=\"ref-19\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-19\">↩</a> 适用性 <a class=\"tm-internal\" data-tm-id=\"517317208\" href=\"#/post/517317208\">站内阅读 ↗</a></li><li id=\"ref-20\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-20\">↩</a> 稳定化 <a class=\"tm-internal\" data-tm-id=\"595158577\" href=\"#/post/595158577\">站内阅读 ↗</a></li><li id=\"ref-21\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-21\">↩</a> 创造力 <a class=\"tm-internal\" data-tm-id=\"450093869\" href=\"#/post/450093869\">站内阅读 ↗</a></li><li id=\"ref-22\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-22\">↩</a> 学校教育的问题 <a class=\"tm-internal\" data-tm-id=\"611469462\" href=\"#/post/611469462\">站内阅读 ↗</a></li><li id=\"ref-23\"><a aria-label=\"返回正文\" class=\"ref-back\" href=\"#cite-23\">↩</a> 彼得 · 沃兹尼亚克 <a class=\"tm-internal\" data-tm-id=\"303204832\" href=\"#/post/303204832\">站内阅读 ↗</a></li></ol>","rec_chain":[{"id":"602150910","title":"学习的乐趣","author":"Piotr Wozniak","votes":1152,"minutes":88,"reason":"本回答Level 1 核心引用"},{"id":"611469462","title":"学校教育的问题","author":"Piotr Wozniak","votes":446,"minutes":10,"reason":"本回答Level 1 核心引用"},{"id":"272543239","title":"自由学习","author":"Piotr Wozniak","votes":299,"minutes":4,"reason":"本回答Level 1 核心引用"},{"id":"711526074","title":"教育和学习无关","author":"Gwern Branwen","votes":265,"minutes":103,"reason":"本回答Level 1 核心引用"},{"id":"52990549","title":"4 学习内驱力","author":"Piotr Wozniak","votes":199,"minutes":7,"reason":"本回答Level 1 核心引用"},{"id":"268536400","title":"知识结晶比喻","author":"Piotr Wozniak","votes":120,"minutes":18,"reason":"本回答Level 1 核心引用"}],"rec_bridge":[{"id":"707179156","title":"暑假滑坡折射学校教育之殇","author":"Piotr Wozniak","votes":109,"minutes":6,"reason":"延伸深读 · Piotr Wozniak"},{"id":"559705516","title":"学校让人沾染上的 100+ 恶习","author":"Piotr Wozniak","votes":8728,"minutes"